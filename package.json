{
  "name": "intact",
  "private": true,
  "description": "AI agents are starting to handle money. Intact checks they keep it intact.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "webhooks:selfcheck": "node --experimental-strip-types --no-warnings webhooks/selfcheck.ts",
    "webhooks:bench": "node --experimental-strip-types --no-warnings webhooks/run.ts",
    "webhooks:prompt": "node --experimental-strip-types --no-warnings webhooks/grade.ts prompt",
    "webhooks:grade": "node --experimental-strip-types --no-warnings webhooks/grade.ts grade",
    "probe": "node --experimental-strip-types --no-warnings probe/run.ts",
    "probe:selfcheck": "node --experimental-strip-types --no-warnings probe/selfcheck.ts",
    "publish": "node --experimental-strip-types --no-warnings probe/publish.ts"
  }
}
